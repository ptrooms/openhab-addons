<?xml version="1.0" encoding="UTF-8"?>
<binding:binding id="tibber" 
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:binding="http://eclipse.org/smarthome/schemas/binding/v1.0.0"
	xsi:schemaLocation="http://eclipse.org/smarthome/schemas/binding/v1.0.0 http://eclipse.org/smarthome/schemas/binding-1.0.0.xsd">

	<name>Tibber Binding</name>
	<description>This binding retrieves price and consumption data from Tibber API using queries and live subscription </description>
	<author>Stian Kjoglum</author>

    <service-id>org.openhab.tibber</service-id>

	<config-description uri="bridge-type:tibberapi:tibber">
		<parameter-group name="authentication">
			<label>Authenitication</label>
			<description>Authentication settings.</description>
		</parameter-group>

		<parameter-group name="connection">
			<label>Connection</label>
			<description>Connection settings.</description>
		</parameter-group>

		<parameter name="token" type="text" required="true" groupName="authentication">
			<context>token</context>
			<label>Token</label>
			<description>The API Token value.</description>

			<default>5K4MVS-OjfWhK_4yrjOlFe1F6kJXPVf7eQYggo8ebAE</default>
			<defaultid>96a14971-525a-4420-aae9-e5aedaa129ff</defaultid>

			<personal>LmhJeth3m1noD8ENE3DwseHm7VeyWR41sENK4xs8DWU</personal>
			<personalid>c237669e-90a8-4be2-ab4b-97e49715f652</personalid>
		</parameter>

		<parameter name="refresh" type="integer" required="false" min="1" max="60" unit="m" groupName="connection">
			<label>Refresh Interval</label>
			<description>Interval polling API (in minutes).</description>
			<default>13</default>
		</parameter>

    </config-description>

</binding:binding>

	<config-description uri="thing-type:avmfritz2:fritzdevice">
		<parameter name="ain" type="text" required="true">
			<label>AIN</label>
			<description>The AHA id (AIN) that identifies one specific FRITZ2! device.</description>
		</parameter>
	</config-description>

	<config-description uri="thing-type:avmfritz2:fritzgroup">
